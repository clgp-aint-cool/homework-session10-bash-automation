WEB_URL="http://localhost:8080/index.html"
MAIL_LOG_FILE="/path/to/alerts.log"
CHECK_INTERVAL_SECONDS=60


ALERT_TO="you@example.com"

DISK_THRESHOLD=90        # % used trên root filesystem, vượt ngưỡng này -> alert
RAM_MIN_FREE=10          # % RAM còn trống tối thiểu, thấp hơn -> alert

SERVICES="sshd cron"

HEALTH_URL="http://localhost:8080"
